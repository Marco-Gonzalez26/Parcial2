  "components": {
    "schemas": {
      "Cliente": {
        "required": [
          "apellido",
          "email",
          "nombre",
          "telefono"
        ],
        "type": "object",
        "properties": {
          "clienteId": {
            "type": "integer",
            "format": "int32"
          },
          "nombre": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "apellido": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string",
            "format": "email"
          },
          "telefono": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "format": "tel"
          },
          "nombreCompleto": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          },
          "ordenes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Orden"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DetalleOrden": {
        "required": [
          "cantidad",
          "ordenId",
          "precioUnitario",
          "productoId"
        ],
        "type": "object",
        "properties": {
          "detalleOrdenId": {
            "type": "integer",
            "format": "int32"
          },
          "ordenId": {
            "type": "integer",
            "format": "int32"
          },
          "productoId": {
            "type": "integer",
            "format": "int32"
          },
          "cantidad": {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "precioUnitario": {
            "maximum": 99999.99,
            "minimum": 0.01,
            "type": "number",
            "format": "currency"
          },
          "subtotal": {
            "type": "number",
            "format": "double",
            "readOnly": true
          },
          "orden": {
            "$ref": "#/components/schemas/Orden"
          },
          "producto": {
            "$ref": "#/components/schemas/Producto"
          }
        },
        "additionalProperties": false
      },
      "Orden": {
        "required": [
          "clienteId",
          "estado",
          "fechaOrden",
          "total"
        ],
        "type": "object",
        "properties": {
          "ordenId": {
            "type": "integer",
            "format": "int32"
          },
          "clienteId": {
            "type": "integer",
            "format": "int32"
          },
          "fechaOrden": {
            "type": "string",
            "format": "date-time"
          },
          "estado": {
            "maxLength": 20,
            "minLength": 0,
            "pattern": "^(Pendiente|Completada|Cancelada)$",
            "type": "string"
          },
          "total": {
            "maximum": 999999.99,
            "minimum": 0,
            "type": "number",
            "format": "currency"
          },
          "cliente": {
            "$ref": "#/components/schemas/Cliente"
          },
          "detallesOrden": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DetalleOrden"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Producto": {
        "required": [
          "color",
          "nombre",
          "precio",
          "talla"
        ],
        "type": "object",
        "properties": {
          "productoId": {
            "type": "integer",
            "format": "int32"
          },
          "nombre": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "talla": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string"
          },
          "color": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "precio": {
            "maximum": 99999.99,
            "minimum": 0.01,
            "type": "number",
            "format": "currency"
          },
          "nombreCompleto": {
            "type": "string",
            "nullable": true,
            "readOnly": true
          },
          "detallesOrden": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DetalleOrden"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateEstadoViewModel": {
        "type": "object",
        "properties": {
          "estado": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}